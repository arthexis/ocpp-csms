# HTTP is only for certificate renewal; no unencrypted OCPP endpoint.
server {
    listen 80;
    server_name {{ ocpp_csms_expose }};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/ocpp-csms-acme;
        default_type text/plain;
    }
    location / { return 404; }
}

# nginx terminates WSS TLS and proxies to the loopback-only CSMS.
server {
    listen 443 ssl;
    server_name {{ ocpp_csms_expose }};
    ssl_certificate /etc/letsencrypt/live/{{ ocpp_csms_expose }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ ocpp_csms_expose }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / {
        proxy_pass http://127.0.0.1:{{ ocpp_csms_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
