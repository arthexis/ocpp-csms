[Unit]
Description=OCPP Discover
Wants=network-online.target ocpp-csms.service
After=network-online.target ocpp-csms.service

[Service]
Type=simple
# Fail before capture, reconciliation or any new redirect when CSMS storage drifts.
ExecStartPre="{{ ocpp_discover_python }}" -m ocpp_discover.storage_contract --data-dir "{{ ocpp_discover_data_dir }}"
ExecStart="{{ ocpp_discover_python }}" -m ocpp_discover service --data-dir "{{ ocpp_discover_data_dir }}" --runtime-dir "{{ ocpp_discover_runtime_dir }}" --persistent-dir "{{ ocpp_discover_persistent_dir }}" --interface "{{ ocpp_discover_interface }}" --listen-port {{ ocpp_discover_port }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
