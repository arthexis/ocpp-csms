# Managed by ocpp-csms private diagnostics (no public WSS)
server {
    listen {{ diag_ip }}:{{ diag_port_num }} ssl;
    server_name {{ diag_ip }};
    server_tokens off;
    ssl_certificate {{ diag_dir }}/cert.pem;
    ssl_certificate_key {{ diag_dir }}/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_header_timeout 15s;
    location ~ "^/ocpp-diagnose/([a-f0-9]{40})/upload\.bin(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,150})?/?$" {
        allow {{ diag_charger_ip }};
        deny all;
        if ($request_method !~ ^(POST|PUT)$) { return 405; }
        client_max_body_size 100m;
        client_body_timeout 120s;
        rewrite "^(/ocpp-diagnose/[a-f0-9]{40})/upload\.bin/[A-Za-z0-9][A-Za-z0-9._-]{0,150}/?$" $1/upload.bin break;
        proxy_method POST;
        proxy_pass http://unix:/run/ocpp-csms-diagnose.sock:;
        proxy_http_version 1.1;
        proxy_set_header Connection close;
        proxy_set_header Host $host;
        proxy_request_buffering on;
        proxy_read_timeout 180s;
    }
    location / { return 404; }
}
