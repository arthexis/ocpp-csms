[Unit]
Description=OCPP CSMS appliance service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
Environment="HOME=@HOME@"
ExecStart="@COMMAND@" --data-dir "@DATA_DIR@" serve --host "@HOST@" --port @PORT@
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
